{
  "description": "Warns at startup when the NappAI MCP server is not registered.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-setup.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
